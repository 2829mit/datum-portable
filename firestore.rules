rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLead(data) {
      return data.keys().hasAll([
        'name', 'mobile', 'email', 'company', 'industry', 'state',
        'consumption', 'salesperson', 'status', 'createdAt'
      ]) &&
      data.keys().size() == 10 &&
      data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
      data.mobile is string && data.mobile.size() >= 10 && data.mobile.size() <= 20 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
      data.company is string && data.company.size() > 0 && data.company.size() <= 200 &&
      data.industry is string && data.industry.size() > 0 && data.industry.size() <= 100 &&
      data.state is string && data.state.size() > 0 && data.state.size() <= 100 &&
      data.consumption is string && data.consumption.size() > 0 && data.consumption.size() <= 100 &&
      data.salesperson is string && data.salesperson.size() > 0 && data.salesperson.size() <= 100 &&
      data.status is string && data.status in ['new', 'contacted', 'qualified', 'closed'] &&
      data.createdAt is timestamp;
    }

    match /leads/{leadId} {
      // Public lead submission creation
      allow create: if isValidId(leadId) && isValidLead(incoming());
      // Disallow public read, update, and delete to safeguard customer PII
      allow read, update, delete: if false;
    }
  }
}
